{
  "manifest_version": 3,
  "name": "Smart Paste Typing",
  "description": "Paste clipboard text into editable fields by simulating human typing.",
  "version": "2.0.0",
  "permissions": [
    "contextMenus",
    "scripting",
    "activeTab",
    "clipboardRead"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Smart Paste Typing",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "commands": {
    "paste-as-typing": {
      "suggested_key": {
        "default": "Ctrl+Shift+V",
        "mac": "Command+Shift+V"
      },
      "description": "Paste as Typing"
    }
  }
}
